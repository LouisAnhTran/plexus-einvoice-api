einvoice.db
einvoice.db-wal
einvoice.db-shm

# VCS and tooling
.git/
.gitignore
.github/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# Docs — changing the README shouldn't invalidate the build cache
README.md
*.md

.DS_Store
