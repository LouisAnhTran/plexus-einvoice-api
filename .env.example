# ─────────────────────────────────────────────────────────────────────────────
#  einvoice-api — dummy InvoiceNow (Peppol) SMP Access Point API
#
#  Copy to .env for local development:   cp .env.example .env
#
#  Every setting is read from the environment with the EINVOICE_ prefix. Real
#  environment variables win over this file, so when this service is deployed
#  on its own you can inject them directly (ECS task definition, Kubernetes
#  Secret, Fly secrets, Railway variables…) and ship no .env at all.
# ─────────────────────────────────────────────────────────────────────────────

# SQLite runs INSIDE this process — it is a library, not a server. There is no
# database daemon, no port, and nothing to host or connect to.
#   :memory:            kept in RAM, wiped on shutdown (default)
#   einvoice.db         a file relative to the working directory, survives restarts
#   /data/einvoice.db   absolute; mount a volume there in a container to persist
EINVOICE_DATABASE_PATH=:memory:

# Shared secret callers send in the X-Api-Key header.
# The MCP server holds this value — it never receives a database credential.
# CHANGE THIS BEFORE DEPLOYING ANYWHERE REACHABLE.
EINVOICE_API_KEY=dev-smp-key

# Seconds a company sits in each pending state before it auto-advances:
#   kycStatus  PENDING              -> REGISTERED
#   taxStatus  PENDING_ACTIVATION   -> ACTIVATED
#              PENDING_DEACTIVATION -> DEACTIVATED
# 30 keeps the async shape without a long wait. Set to 1-5 in automated tests.
EINVOICE_AUTO_ADVANCE_SECONDS=30
